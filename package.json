{
  "name": "jimuel-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check index.html professional.css script.js src effects.json",
    "format": "prettier --write index.html professional.css script.js src effects.json",
    "dev": "vite --host 127.0.0.1 --port 4180",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "lint": "eslint script.js src vite.config.js"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
